<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_tools"
            android:textAppearance="@style/TextAppearance.MWYD.Display"
            android:textColor="?attr/colorOnBackground"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_section_library"
                    style="@style/TextAppearance.MWYD.SectionTitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/terminal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/terminal"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:drawablePadding="20dp"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_terminal"
                    app:drawableTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/logs"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:drawablePadding="20dp"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_baseline_file_open_24" />

                <TextView
                    android:id="@+id/command_templates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/command_templates"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:drawablePadding="20dp"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_baseline_keyboard_arrow_right_24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_section_downloads"
                    style="@style/TextAppearance.MWYD.SectionTitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/downloads"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/downloads"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:drawablePadding="20dp"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_downloads" />

                <TextView
                    android:id="@+id/download_queue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/download_queue"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:drawablePadding="20dp"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/baseline_downloading_24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_section_account"
                    style="@style/TextAppearance.MWYD.SectionTitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/cookies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cookies"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:drawablePadding="20dp"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/baseline_cookie_24" />

                <TextView
                    android:id="@+id/observe_sources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/observe_sources"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:drawablePadding="20dp"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/baseline_calendar_month_24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_section_system"
                    style="@style/TextAppearance.MWYD.SectionTitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/terminate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kill_app"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:drawablePadding="20dp"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_power" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="4dp"
                    android:background="?attr/colorOutlineVariant" />

                <TextView
                    android:id="@+id/settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:drawablePadding="20dp"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
